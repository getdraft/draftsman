# DRAFT Framework 1.0 — Product Repo Sync GitHub Action
# This workflow fires when .draft/sdp.yaml is updated in this engineering repo,
# uses an ephemeral short-lived GitHub App token (or OIDC secret), and pushes
# the sdp.yaml payload to the central drafting-table workspace.
name: Sync SDP to Central DRAFT Workspace

on:
  push:
    branches: [ main, master ]
    paths:
      - '.draft/sdp.yaml'
      - '.draft/catalog/**'

jobs:
  transmit_sdp:
    name: Transmit SDP to drafting-table
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout Product Repository
        uses: actions/checkout@v4

      - name: Generate Ephemeral App Token for Central Workspace
        id: generate_token
        uses: actions/create-github-app-token@v1
        with:
          app-id: ${{ secrets.DRAFT_APP_ID }}
          private-key: ${{ secrets.DRAFT_APP_PRIVATE_KEY }}
          repositories: "${{ secrets.DRAFT_CENTRAL_REPO_NAME }}" # e.g. company-drafting-table

      - name: Dispatch SDP Payload to Central Workspace
        run: |
          if [ ! -f .draft/sdp.yaml ]; then
            echo "No .draft/sdp.yaml found, skipping sync."
            exit 0
          fi

          SDP_PAYLOAD=$(jq -s -R . .draft/sdp.yaml)
          REPO_NAME="${{ github.repository }}"
          CENTRAL_REPO="${{ secrets.DRAFT_CENTRAL_REPO_NAME }}"
          ORG_NAME="${{ github.repository_owner }}"

          curl -X POST \
            -H "Authorization: bearer ${{ steps.generate_token.outputs.token }}" \
            -H "Accept: application/vnd.github.v3+json" \
            "https://api.github.com/repos/${ORG_NAME}/${CENTRAL_REPO}/dispatches" \
            -d @- <<EOF
          {
            "event_type": "sdp_updated",
            "client_payload": {
              "product_id": "${REPO_NAME}",
              "sdp_content": ${SDP_PAYLOAD}
            }
          }
          EOF
