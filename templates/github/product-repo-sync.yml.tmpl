# DRAFT Framework 1.0 — Product Repo Sync GitHub Action
# This workflow fires when .draft/sdp.yaml or .draft/catalog/ changes in this engineering repo,
# packs them with the framework's sdp_sync.py, uses an ephemeral short-lived GitHub App token,
# and sends the payload to the central drafting-table workspace as a repository_dispatch event.
# Values reach the scripts only through environment variables and files, never as script text.
name: Sync SDP to Central DRAFT Workspace

on:
  push:
    branches: [ main, master ]
    paths:
      - '.draft/sdp.yaml'
      - '.draft/catalog/**'

jobs:
  transmit_sdp:
    name: Transmit SDP to drafting-table
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout Product Repository
        uses: actions/checkout@v4

      - name: Generate Ephemeral App Token for Central Workspace
        id: generate_token
        uses: actions/create-github-app-token@v1
        with:
          app-id: ${{ secrets.DRAFT_APP_ID }}
          private-key: ${{ secrets.DRAFT_APP_PRIVATE_KEY }}
          repositories: "${{ secrets.DRAFT_CENTRAL_REPO_NAME }}" # e.g. frontline-drafting-table

      - name: Checkout the DRAFT sync tool
        uses: actions/checkout@v4
        with:
          repository: getdraft/draftsman
          # Set the DRAFT_FRAMEWORK_REF repository variable to the central workspace's framework version tag.
          ref: ${{ vars.DRAFT_FRAMEWORK_REF || 'main' }}
          path: .draft-sync-tool
          sparse-checkout: framework/tools

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Pack SDP Payload
        env:
          REPOSITORY: ${{ github.repository }}
          COMMIT: ${{ github.sha }}
          REF: ${{ github.ref }}
          CORRELATION_ID: ${{ github.run_id }}-${{ github.run_attempt }}
        run: |
          python -m pip install --quiet pyyaml
          python3 .draft-sync-tool/framework/tools/sdp_sync.py pack \
            --repo-root . \
            --repository "$REPOSITORY" \
            --commit "$COMMIT" \
            --ref "$REF" \
            --correlation-id "$CORRELATION_ID" \
            --output "$RUNNER_TEMP/sdp-payload.json"

      - name: Dispatch SDP Payload to Central Workspace
        env:
          GH_TOKEN: ${{ steps.generate_token.outputs.token }}
          CENTRAL_OWNER: ${{ github.repository_owner }}
          CENTRAL_REPO: ${{ secrets.DRAFT_CENTRAL_REPO_NAME }}
        run: |
          jq -n --slurpfile payload "$RUNNER_TEMP/sdp-payload.json" \
            '{event_type: "sdp_updated", client_payload: $payload[0]}' \
          | curl --fail-with-body --silent --show-error -X POST \
              -H "Authorization: Bearer $GH_TOKEN" \
              -H "Accept: application/vnd.github+json" \
              -H "X-GitHub-Api-Version: 2022-11-28" \
              --data @- \
              "https://api.github.com/repos/$CENTRAL_OWNER/$CENTRAL_REPO/dispatches"
