# DRAFT Framework 1.0 — Central Receiver GitHub Action
# This workflow receives decentralized SDP updates sent by engineering product repos, stores them
# with the framework's sdp_sync.py, validates the workspace, and regenerates the central indexes.
# The payload is read from the event file by the tool; no payload value is placed in script text.
# The tool verifies the sender's GitHub Actions OIDC token (audience: this repository) against GitHub's
# published keys before storing anything. Nothing is pushed to the default branch: each product's changes
# go to a draft-sync/<product> branch and one pull request that later syncs update.
# Repository settings: allow GitHub Actions to create pull requests. Optional repository variable
# DRAFT_SYNC_AUTO_MERGE=true requests auto-merge when a change stays inside that product's cache folder.
# Every run ends with a report: a job summary, and (once the sender's identity is verified) a result file on the
# draft-sync-results branch that the product repository's sync run waits for and fails on.
# Optional unattended merge: repository secrets DRAFT_RECEIVER_APP_ID and DRAFT_RECEIVER_APP_PRIVATE_KEY
# (a second GitHub App, installed only on this repository). When both are set, the workflow mints an
# installation token before checkout, checks out with it, and passes it as GH_TOKEN to publish and report.
# The force-push then authenticates as the App, so pull_request runs are not held for approval.
# GitHub auto-merge does not honor a ruleset bypass, so this workflow does not arm --auto in that case.
# templates/github/drafting-table-sync-merge.yml.tmpl merges the pull request after validate succeeds.
# When the secrets are absent, or minting fails, checkout, Python setup, and the PyYAML install still run
# (if: always()) with GITHUB_TOKEN so the report can import PyYAML and write the job summary.
name: DRAFT Decentralized SDP Receiver

on:
  repository_dispatch:
    types: [ sdp_updated ]

permissions:
  contents: write
  pull-requests: write

# One sync at a time, so pull requests and regenerated indexes never race.
concurrency:
  group: draft-sdp-sync
  cancel-in-progress: false

jobs:
  sync_sdp:
    name: Ingest & Validate Decentralized SDP
    runs-on: ubuntu-latest

    steps:
      # Secrets are not available in an if: condition. This step prints only present=true or present=false.
      # The private key stays on this step; it is not a job-level environment variable.
      - name: Detect Receiver App Credentials
        id: receiver_app
        env:
          RECEIVER_APP_ID: ${{ secrets.DRAFT_RECEIVER_APP_ID }}
          RECEIVER_APP_PRIVATE_KEY: ${{ secrets.DRAFT_RECEIVER_APP_PRIVATE_KEY }}
        run: |
          if [ -n "$RECEIVER_APP_ID" ] && [ -n "$RECEIVER_APP_PRIVATE_KEY" ]; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          elif [ -z "$RECEIVER_APP_ID" ] && [ -z "$RECEIVER_APP_PRIVATE_KEY" ]; then
            echo "present=false" >> "$GITHUB_OUTPUT"
          else
            echo "::error title=DRAFT receiver App::Set both DRAFT_RECEIVER_APP_ID and DRAFT_RECEIVER_APP_PRIVATE_KEY, or neither. One of them is missing."
            exit 1
          fi

      - name: Mint Receiver App Token
        id: receiver_token
        if: steps.receiver_app.outputs.present == 'true'
        # v1.12.0. Pinned to a commit because this step receives the App private key.
        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547
        with:
          app-id: ${{ secrets.DRAFT_RECEIVER_APP_ID }}
          private-key: ${{ secrets.DRAFT_RECEIVER_APP_PRIVATE_KEY }}
          # This workflow runs in the central repository. Scope the installation token to it.
          repositories: "${{ github.event.repository.name }}"
          permission-contents: write
          permission-pull-requests: write

      - name: Checkout Workspace
        if: always()
        uses: actions/checkout@v4
        with:
          # publish force-pushes with these credentials, not with GH_TOKEN.
          # A GITHUB_TOKEN push still creates pull_request synchronize, and GitHub holds that run
          # for "Approve workflows to run"; it does not go green unattended. The App token does.
          # A failed or skipped mint selects github.token, and this step still runs so report can write.
          token: ${{ steps.receiver_token.outcome == 'success' && steps.receiver_token.outputs.token || github.token }}
          persist-credentials: true

      - name: Set up Python
        if: always()
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        if: always()
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml

      - name: Store Decentralized SDP Payload
        env:
          CENTRAL_REPOSITORY: ${{ github.repository }}
        run: |
          python3 .draft/framework/tools/sdp_sync.py receive \
            --workspace . \
            --payload "$GITHUB_EVENT_PATH" \
            --central-repository "$CENTRAL_REPOSITORY" \
            --result "$RUNNER_TEMP/sdp-sync-result.json"

      - name: Validate Workspace Architecture
        shell: bash
        run: |
          python3 .draft/framework/tools/validate.py --workspace . 2>&1 | tee "$RUNNER_TEMP/validate.log"

      - name: Regenerate Machine Indexes & AI Map
        run: |
          python3 .draft/framework/tools/generate_indexes.py --workspace .
          python3 .draft/framework/tools/generate_ai_index.py

      - name: Publish Sync Pull Request
        env:
          GH_TOKEN: ${{ steps.receiver_token.outcome == 'success' && steps.receiver_token.outputs.token || github.token }}
          BASE_BRANCH: ${{ github.event.repository.default_branch }}
          # The App path merges from drafting-table-sync-merge.yml.tmpl. --auto cannot finish a required review.
          AUTO_MERGE: ${{ steps.receiver_token.outcome == 'success' && 'false' || vars.DRAFT_SYNC_AUTO_MERGE }}
          # Same name as workflows: in drafting-table-sync-merge.yml.tmpl. Change both together.
          VALIDATE_WORKFLOW: Validate Catalog
        run: |
          python3 .draft/framework/tools/sdp_sync.py publish \
            --workspace . \
            --result "$RUNNER_TEMP/sdp-sync-result.json" \
            --base "$BASE_BRANCH" \
            --auto-merge "${AUTO_MERGE:-false}" \
            --validate-workflow "${VALIDATE_WORKFLOW:-Validate Catalog}"

      - name: Report Sync Result
        if: always()
        env:
          GH_TOKEN: ${{ steps.receiver_token.outcome == 'success' && steps.receiver_token.outputs.token || github.token }}
          JOB_STATUS: ${{ job.status }}
          BASE_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          python3 .draft/framework/tools/sdp_sync.py report \
            --workspace . \
            --payload "$GITHUB_EVENT_PATH" \
            --result "$RUNNER_TEMP/sdp-sync-result.json" \
            --validate-log "$RUNNER_TEMP/validate.log" \
            --job-status "$JOB_STATUS" \
            --base "$BASE_BRANCH" \
            --summary "$GITHUB_STEP_SUMMARY"
